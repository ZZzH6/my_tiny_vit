.codex
# =========================
# 1. 数据集与原始数据
# =========================
dataset/
datasets/

# 但如果你未来希望保留 data 目录结构里的代码文件（如 data/build_loader.py），
# 那就不要忽略整个 data/ 目录，而应只忽略其中的数据文件夹。
# 下面是更推荐的写法（二选一，不要和上面的 data/ 同时用）：
# data/raw/
# data/processed/
# data/external/
# data/interim/
# data/tiny-imagenet-200/
# data/cifar-10-batches-py/
# data/cifar-100-python/

# =========================
# 2. 模型权重 / checkpoint
# =========================
checkpoints/
*.pth
*.pt
*.ckpt
*.bin
*.onnx
*.engine
*.trt
*.safetensors

# =========================
# 3. 实验结果与导出产物
# =========================
results/logs/
results/checkpoints/
results/metrics/
results/summary/
results/eval/
results/figures/
results/tables/
outputs/
runs/
mlruns/

# 如果你未来想保留 results 目录结构本身，可使用：
# results/logs/*
# results/figures/*
# results/tables/*
# !results/logs/.gitkeep
# !results/figures/.gitkeep
# !results/tables/.gitkeep

# =========================
# 4. Python 缓存与编译文件
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# 5. Jupyter Notebook 缓存
# =========================
.ipynb_checkpoints/

# =========================
# 6. 虚拟环境
# =========================
venv/
.venv/
env/
ENV/
conda-env/
.python-version

# =========================
# 7. 日志、临时文件、调试文件
# =========================
*.log
*.out
*.err
*.tmp
*.temp
*.swp
*.swo
*.bak

# =========================
# 8. Python 打包/构建产物
# =========================
build/
dist/
site/
.eggs/
*.egg
*.egg-info/
pip-wheel-metadata/

# =========================
# 9. 测试与覆盖率
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# =========================
# 10. 类型检查/静态分析缓存
# =========================
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# =========================
# 11. IDE / 编辑器配置
# =========================
.vscode/
.idea/

# =========================
# 12. 操作系统文件
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# 13. 下载压缩包与大文件
# =========================
*.zip
*.tar
*.gz
*.tgz
*.bz2
*.xz
*.7z
*.rar

# =========================
# 14. 深度学习框架/模型缓存
# =========================
.cache/
.huggingface/
huggingface/
wandb/

# torch / timm / hub 常见缓存
torchhub/
hub/

# =========================
# 15. Streamlit / Gradio / Demo 运行缓存
# =========================
.streamlit/secrets.toml
gradio_cached_examples/

# =========================
# 16. 导出与部署中间文件
# =========================
*.mlmodel
*.tflite
*.pb
*.pbtxt
saved_model/
*.lite

# =========================
# 17. 可选：忽略本地配置，但保留模板
# =========================
.env
.env.*
!.env.example

# =========================
# 18. 可选：保留空目录结构
# =========================
!checkpoints/.gitkeep
!results/.gitkeep
!results/logs/.gitkeep
!results/figures/.gitkeep
!results/tables/.gitkeep
